# Backend daemon URL (local loopback or Cloudflare tunnel URL)
WORKSTATION_BACKEND_URL=http://127.0.0.1:8000

# Secret API key (Bearer token) matching the backend daemon
WORKSTATION_API_KEY=your_daemon_api_key_here

# Operator password to unlock the /workstation console and API gate
WORKSTATION_PASSWORD=your_operator_password_here

# Optional public API fallback URL
# NEXT_PUBLIC_API_URL=https://api.workstation.example.com

# Canonical frontend site URL (used for SEO, OpenGraph metadata, and sitemaps)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Next.js server runtime
PORT=3000
HOSTNAME=0.0.0.0
