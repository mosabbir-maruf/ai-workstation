# ==============================================================================
# AI Workstation — Web Frontend Environment Configuration
# ==============================================================================

# Backend API Configuration
# Base URL for the ai-workstation HTTP daemon.
# When the frontend is hosted separately from the backend (e.g. VPS or separate domain),
# set this to the public URL of the backend API service.
#
# Examples:
#   Local development with local backend:      http://localhost:8000
#   Hosted frontend connecting to VPS backend: https://api.workstation.example.com
#   Same-machine / reverse-proxied (default):  (leave blank or set to relative /api)
NEXT_PUBLIC_API_URL=

# Server-Side Backend Proxy URL (used by Next.js route handlers)
# If the frontend acts as a reverse proxy, set this to the internal or loopback address.
# Examples:
#   Local:                    http://127.0.0.1:8000
#   Inside Docker container:  http://host.docker.internal:8000
WORKSTATION_BACKEND_URL=

# Canonical Frontend Site URL (used for SEO, OpenGraph metadata, and sitemaps)
# Example: https://workstation.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Next.js Server Runtime
PORT=3000
HOSTNAME=0.0.0.0
