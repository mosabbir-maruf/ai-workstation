#!/usr/bin/env bash
set -euo pipefail

ROOT="${AI_WORKSTATION_ROOT:-$HOME/ai-workstation}"
ENV_FILE="$ROOT/.env"
COMPOSE_FILE="$ROOT/docker/compose.yml"
PROJECTS_DIR="$HOME/projects"
RUNTIME_DIR="$ROOT/runtime"
GITHUB_LIB="$ROOT/scripts/lib/github.sh"

mkdir -p "$PROJECTS_DIR" "$RUNTIME_DIR"

die() {
    echo "ERROR: $*" >&2
    exit 1
}

load_env() {
    [[ -f "$ENV_FILE" ]] || cp "$ROOT/.env.example" "$ENV_FILE"

    local env_image="${IMAGE:-}"
    local env_dsh_version="${DSH_VERSION:-}"
    local env_root="${AI_WORKSTATION_ROOT:-}"

    set -a
    source "$ENV_FILE"
    set +a

    [[ -n "$env_image" ]] && IMAGE="$env_image"
    [[ -n "$env_dsh_version" ]] && DSH_VERSION="$env_dsh_version"
    [[ -n "$env_root" ]] && AI_WORKSTATION_ROOT="$env_root"

    export IMAGE DSH_VERSION AI_WORKSTATION_ROOT
}

save_env() {
    local image dsh_version workstation_root
    local github_app_id github_installation_id github_broker_gid github_broker_socket

    image="$(grep '^IMAGE=' "$ENV_FILE" 2>/dev/null | cut -d= -f2- || true)"
    dsh_version="$(grep '^DSH_VERSION=' "$ENV_FILE" 2>/dev/null | cut -d= -f2- || true)"
    workstation_root="$(grep '^AI_WORKSTATION_ROOT=' "$ENV_FILE" 2>/dev/null | cut -d= -f2- || true)"

    github_app_id="$(grep '^GITHUB_APP_ID=' "$ENV_FILE" 2>/dev/null | cut -d= -f2- || true)"
    github_installation_id="$(grep '^GITHUB_INSTALLATION_ID=' "$ENV_FILE" 2>/dev/null | cut -d= -f2- || true)"
    github_broker_gid="$(grep '^GITHUB_BROKER_GID=' "$ENV_FILE" 2>/dev/null | cut -d= -f2- || true)"
    github_broker_socket="$(grep '^GITHUB_BROKER_SOCKET=' "$ENV_FILE" 2>/dev/null | cut -d= -f2- || true)"

    image="${image:-${IMAGE:-ghcr.io/mosabbir-maruf/ai-workstation:latest}}"
    dsh_version="${dsh_version:-${DSH_VERSION:-0.1.2-rc.1}}"
    workstation_root="${workstation_root:-${AI_WORKSTATION_ROOT:-$ROOT}}"

    cat > "$ENV_FILE" <<EOF2
IMAGE=$image
DSH_VERSION=$dsh_version
ACTIVE_PROJECT=${ACTIVE_PROJECT:-}
ACTIVE_PROJECT_PATH=${ACTIVE_PROJECT_PATH:-}
AI_WORKSTATION_ROOT=$workstation_root
GITHUB_APP_ID=$github_app_id
GITHUB_INSTALLATION_ID=$github_installation_id
GITHUB_BROKER_SOCKET=$github_broker_socket
GITHUB_BROKER_GID=$github_broker_gid
EOF2
}
compose() {
    load_env
    docker compose \
        --project-directory "$ROOT" \
        -f "$COMPOSE_FILE" \
        "$@"
}

require_active() {
    load_env
    [[ -n "${ACTIVE_PROJECT:-}" ]] ||
        die "No active project. Use: ai use <project>"

    [[ -d "${ACTIVE_PROJECT_PATH:-}" ]] ||
        die "Active project path does not exist."
}

cmd_add() {
    local url="${1:-}"
    [[ -n "$url" ]] || die "Usage: ai add <github-url>"

    local name
    name="$(basename "${url%.git}")"

    [[ ! -e "$PROJECTS_DIR/$name" ]] ||
        die "Project already exists: $name"

    git clone "$url" "$PROJECTS_DIR/$name"

    echo "Project added: $name"
    echo "Run: ai use $name"
}

cmd_remove() {
    local name="${1:-}"
    [[ -n "$name" ]] || die "Usage: ai remove <project>"

    load_env

    if [[ "${ACTIVE_PROJECT:-}" == "$name" ]]; then
        compose down >/dev/null 2>&1 || true
        ACTIVE_PROJECT=""
        ACTIVE_PROJECT_PATH=""
        save_env
    fi

    rm -rf -- "$PROJECTS_DIR/$name"
    echo "Removed: $name"
}

cmd_list() {
    echo "Projects:"
    shopt -s nullglob

    local found=0

    for dir in "$PROJECTS_DIR"/*; do
        if [[ -d "$dir/.git" ]]; then
            found=1

            load_env

            if [[ "${ACTIVE_PROJECT:-}" == "$(basename "$dir")" ]]; then
                echo "  * $(basename "$dir")"
            else
                echo "    $(basename "$dir")"
            fi
        fi
    done

    [[ "$found" -eq 1 ]] || echo "  (none)"
}

cmd_use() {
    local name="${1:-}"
    [[ -n "$name" ]] || die "Usage: ai use <project>"

    local path="$PROJECTS_DIR/$name"

    [[ -d "$path/.git" ]] ||
        die "Git project not found: $name"

    docker rm -f ai-workstation >/dev/null 2>&1 || true

    ACTIVE_PROJECT="$name"
    ACTIVE_PROJECT_PATH="$path"

    save_env

    echo "Active project: $name"
    echo "Path: $path"
}

cmd_pull() {
    require_active
    cd "$ACTIVE_PROJECT_PATH"
    git pull --ff-only
}

cmd_push() {
    local message="${1:-}"
    [[ -n "$message" ]] || die 'Usage: ai push "commit message"'

    require_active

    cd "$ACTIVE_PROJECT_PATH"

    git add -A

    if git diff --cached --quiet; then
        echo "Nothing to commit."
        return
    fi

    git commit -m "$message"
    git push
}

HARNESS_RUNTIME_DIR="$RUNTIME_DIR/harness"

harness_exec() {
    docker exec ai-workstation \
        /usr/local/bin/harness.sh "$@"
}

cmd_harness_start() {
    docker ps --format '{{.Names}}' |
        grep -qx ai-workstation ||
        die "Workstation is not running."

    harness_exec start
}

cmd_harness_stop() {
    docker ps --format '{{.Names}}' |
        grep -qx ai-workstation ||
        return 0

    harness_exec stop
}

cmd_harness_restart() {
    docker ps --format '{{.Names}}' |
        grep -qx ai-workstation ||
        die "Workstation is not running."

    harness_exec restart
}

cmd_harness_status() {
    docker ps --format '{{.Names}}' |
        grep -qx ai-workstation ||
        {
            echo "Harness: stopped (workstation is not running)"
            return 0
        }

    harness_exec status || true
}

cmd_start() {
    require_active

    mkdir -p \
        "$RUNTIME_DIR/dsh" \
        "$RUNTIME_DIR/npm-global" \
        "$HARNESS_RUNTIME_DIR"

    chmod 700 \
        "$RUNTIME_DIR/dsh" \
        "$RUNTIME_DIR/npm-global" \
        "$HARNESS_RUNTIME_DIR"

    compose up -d

    cmd_harness_start

    echo "Workstation started."
}

cmd_stop() {
    cmd_app_stop || true
    cmd_harness_stop || true
    compose down
    rm -f "$APP_PID_FILE"
    echo "Workstation stopped."
}

cmd_restart() {
    compose restart
    cmd_harness_start
}

APP_RUNTIME_DIR="$RUNTIME_DIR/app"
APP_PID_FILE="$APP_RUNTIME_DIR/pid"

app_container_pid() {
    docker exec ai-workstation sh -lc '
        if [ -f /run/ai-workstation/app/pid ]; then
            cat /run/ai-workstation/app/pid
        fi
    ' 2>/dev/null || true
}

app_running() {
    local pid
    pid="$(app_container_pid)"

    [[ "$pid" =~ ^[0-9]+$ ]] || return 1

    docker exec ai-workstation sh -lc \
        "kill -0 $pid 2>/dev/null"
}

detect_package_manager() {
    require_active

    if [[ -f "$ACTIVE_PROJECT_PATH/package-lock.json" ]]; then
        echo "npm"
    elif [[ -f "$ACTIVE_PROJECT_PATH/pnpm-lock.yaml" ]]; then
        echo "pnpm"
    elif [[ -f "$ACTIVE_PROJECT_PATH/yarn.lock" ]]; then
        echo "yarn"
    elif [[ -f "$ACTIVE_PROJECT_PATH/bun.lockb" || -f "$ACTIVE_PROJECT_PATH/bun.lock" ]]; then
        echo "bun"
    else
        die "Could not detect package manager."
    fi
}

cmd_run() {
    require_active

    docker ps --format '{{.Names}}' |
        grep -qx ai-workstation ||
        die "Workstation is not running. Run: ai start"

    if app_running; then
        echo "Project already running."
        echo "PID: $(app_container_pid)"
        return 0
    fi

    local manager
    manager="$(detect_package_manager)"

    local command
    case "$manager" in
        npm)  command='npm run dev' ;;
        pnpm) command='pnpm dev' ;;
        yarn) command='yarn dev' ;;
        bun)  command='bun run dev' ;;
        *) die "Unsupported package manager: $manager" ;;
    esac

    mkdir -p "$APP_RUNTIME_DIR"
    chmod 700 "$APP_RUNTIME_DIR"

    rm -f "$APP_PID_FILE"

    echo "Checking dependencies..."

    if ! docker exec ai-workstation sh -lc '
        test -d /workspace/node_modules
    '; then
        echo "Dependencies missing. Installing from lockfile..."

        case "$manager" in
            npm)
                docker exec ai-workstation                     sh -lc 'cd /workspace && npm ci'
                ;;
            pnpm)
                docker exec ai-workstation                     sh -lc 'cd /workspace && pnpm install --frozen-lockfile'
                ;;
            yarn)
                docker exec ai-workstation                     sh -lc 'cd /workspace && yarn install --immutable'
                ;;
            bun)
                docker exec ai-workstation                     sh -lc 'cd /workspace && bun install --frozen-lockfile'
                ;;
            *)
                die "Unsupported package manager: $manager"
                ;;
        esac

        echo "Dependencies installed."
    else
        echo "Dependencies: ready"
    fi

    echo "Starting $ACTIVE_PROJECT..."
    echo "Package manager: $manager"
    echo "Command: $command"

    docker exec -d ai-workstation \
        /usr/local/bin/app-runner.sh \
        bash -lc "$command" >/dev/null

    local ready=0
    local i

    for i in {1..20}; do
        if app_running; then
            ready=1
            break
        fi
        sleep 0.25
    done

    if [[ "$ready" -ne 1 ]]; then
        echo "Project failed to start." >&2
        echo >&2
        echo "Recent logs:" >&2

        docker exec ai-workstation \
            sh -lc 'tail -n 80 /run/ai-workstation/app/app.log' >&2 || true

        rm -f "$APP_PID_FILE"
        return 1
    fi

    echo "Project started."
    echo "PID: $(app_container_pid)"
    echo "Logs: ai app logs"
}

cmd_app_stop() {
    if ! docker ps --format '{{.Names}}' |
        grep -qx ai-workstation; then
        echo "Workstation is not running."
        return 0
    fi

    local pid
    local pgid
    local remaining

    pid="$(app_container_pid)"

    if [[ ! "$pid" =~ ^[0-9]+$ ]]; then
        rm -f "$APP_PID_FILE" "$APP_RUNTIME_DIR/pgid"
        echo "Project is not running."
        return 0
    fi

    pgid="$(
        docker exec ai-workstation sh -lc '
            cat /run/ai-workstation/app/pgid 2>/dev/null || true
        ' 2>/dev/null || true
    )"

    if [[ "$pgid" =~ ^[0-9]+$ ]] && [[ "$pgid" != "1" ]]; then
        docker exec ai-workstation sh -lc "
            kill -TERM -- -$pgid 2>/dev/null || true
            sleep 1

            remaining=\$(ps -eo pid=,pgid= | awk -v g='$pgid' '\$2 == g {print \$1}')

            if [ -n \"\$remaining\" ]; then
                kill -KILL \$remaining 2>/dev/null || true
            fi

            kill -TERM $pid 2>/dev/null || true
            sleep 0.25
            kill -KILL $pid 2>/dev/null || true
        " >/dev/null 2>&1 || true
    else
        docker exec ai-workstation sh -lc "
            kill -TERM $pid 2>/dev/null || true
            sleep 1
            kill -KILL $pid 2>/dev/null || true
        " >/dev/null 2>&1 || true
    fi

    rm -f "$APP_PID_FILE" "$APP_RUNTIME_DIR/pgid"

    echo "Project stopped."
}
cmd_app_restart() {
    require_active
    cmd_app_stop
    cmd_run
}

cmd_app_status() {
    load_env

    echo "=== Project ==="
    echo "Project: ${ACTIVE_PROJECT:-none}"

    if app_running; then
        echo "Status: running"
        echo "PID: $(app_container_pid)"
    else
        echo "Status: stopped"
    fi
}

cmd_app_logs() {
    docker ps --format '{{.Names}}' |
        grep -qx ai-workstation ||
        die "Workstation is not running."

    docker exec ai-workstation \
        sh -lc 'tail -n 100 -f /run/ai-workstation/app/app.log'
}

cmd_status() {
    load_env

    echo "=== AI Workstation ==="
    echo "Active project: ${ACTIVE_PROJECT:-none}"
    echo "Project path: ${ACTIVE_PROJECT_PATH:-none}"
    echo

    compose ps
}

cmd_logs() {
    compose logs -f --tail=100
}

cmd_shell() {
    require_active
    docker exec -it ai-workstation bash
}

cmd_preview() {
    echo "Mac SSH tunnel:"
    echo
    echo "ssh -L 3000:127.0.0.1:3000 \\"
    echo "    -L 3001:127.0.0.1:3001 \\"
    echo "    -L 8000:127.0.0.1:8000 \\"
    echo "    -L 4090:127.0.0.1:4090 \\"
    echo "    mosabbir-cloud"
    echo
    echo "Client : http://127.0.0.1:3000"
    echo "Admin  : http://127.0.0.1:3001"
    echo "Backend: http://127.0.0.1:8000"
    echo "DSH    : http://127.0.0.1:4090"
}

cmd_dsh_update() {
    require_active

    local version="${1:-latest}"

    if [[ "$version" == "latest" ]]; then
        docker exec ai-workstation \
            npm install --prefix /home/sandbox/.npm-global \
            @deepseek-ai/dsh@latest
    else
        docker exec ai-workstation \
            npm install --prefix /home/sandbox/.npm-global \
            "@deepseek-ai/dsh@$version"
    fi

    echo "DSH updated."
}

cmd_dsh_version() {
    docker exec ai-workstation         node /home/sandbox/.npm-global/node_modules/@deepseek-ai/dsh/lib/bin.js         --version
}

cmd_cache() {
    echo "=== Docker ==="
    docker system df

    echo
    echo "=== AI runtime ==="
    du -sh "$RUNTIME_DIR" 2>/dev/null || true

    echo
    echo "=== Project node_modules ==="
    find "$PROJECTS_DIR" \
        -type d \
        -name node_modules \
        -prune \
        -exec du -sh {} \; 2>/dev/null || true
}

cmd_cache_clear() {
    docker builder prune -af

    if docker ps --format '{{.Names}}' |
        grep -qx ai-workstation; then
        docker exec ai-workstation npm cache clean --force || true
    fi
}

cmd_update() {
    git -C "$ROOT" pull --ff-only
    compose pull
}

cmd_upgrade() {
    cmd_update
    compose up -d
}

cmd_doctor() {
    echo "=== AI Workstation Doctor ==="

    command -v docker >/dev/null ||
        die "Docker not installed."

    docker info >/dev/null ||
        die "Docker daemon unavailable."

    [[ -f "$ENV_FILE" ]] ||
        die ".env missing."

    load_env

    echo "Docker: OK"
    echo "Config: OK"

    if [[ -n "${ACTIVE_PROJECT_PATH:-}" ]] &&
       [[ -d "${ACTIVE_PROJECT_PATH:-}" ]]; then
        echo "Project: OK"
        echo "Project: ${ACTIVE_PROJECT:-unknown}"
    else
        echo "Project: none selected"
    fi

    if docker ps --format '{{.Names}}' |
       grep -qx ai-workstation; then
        echo "Container: running"
    else
        echo "Container: stopped"
    fi

    echo
    echo "Doctor complete."
}

cmd_state_export() {
    mkdir -p "$HOME/ai-state-backups"

    local output
    output="$HOME/ai-state-backups/ai-state-$(date +%Y%m%d-%H%M%S).tar.gz"

    tar -czf "$output" \
        -C "$ROOT" \
        runtime \
        .env

    chmod 600 "$output"

    echo "State exported:"
    echo "$output"
}

cmd_state_import() {
    local archive="${1:-}"
    [[ -f "$archive" ]] ||
        die "Usage: ai state import <archive>"

    compose down >/dev/null 2>&1 || true

    tar -xzf "$archive" -C "$ROOT"

    echo "State imported."
}

cmd_github() {
    local action="${1:-}"

    [[ -f "$GITHUB_LIB" ]] ||
        die "GitHub module not found: $GITHUB_LIB"

    case "$action" in
        setup|status|test)
            bash "$GITHUB_LIB" "$action"
            ;;
        *)
            die "Usage: ai github {setup|status|test}"
            ;;
    esac
}

usage() {
    cat <<EOF2
AI Workstation

Projects:
  ai add <github-url>
  ai remove <project>
  ai list
  ai use <project>

Git:
  ai pull
  ai push "commit message"

Runtime:
  ai start
  ai stop
  ai restart
  ai status
  ai logs
  ai shell
  ai run
  ai app stop
  ai app restart
  ai app status
  ai app logs
  ai preview

DSH:
  ai dsh update [version]
  ai dsh version

Maintenance:
  ai cache
  ai cache clear
  ai update
  ai upgrade
  ai doctor

GitHub:
  ai github setup
  ai github status
  ai github test

State:
  ai state export
  ai state import <archive>
EOF2
}

case "${1:-}" in
    add) shift; cmd_add "$@" ;;
    remove) shift; cmd_remove "$@" ;;
    list) cmd_list ;;
    use) shift; cmd_use "$@" ;;
    pull) cmd_pull ;;
    push) shift; cmd_push "$@" ;;
    start) cmd_start ;;
    stop) cmd_stop ;;
    restart) cmd_restart ;;
    harness)
        shift
        case "${1:-}" in
            start)
                cmd_harness_start
                ;;
            stop)
                cmd_harness_stop
                ;;
            restart)
                cmd_harness_restart
                ;;
            status)
                cmd_harness_status
                ;;
            *)
                die "Usage: ai harness {start|stop|restart|status}"
                ;;
        esac
        ;;
    status) cmd_status ;;
    logs) cmd_logs ;;
    shell) cmd_shell ;;
    run) cmd_run ;;
    app)
        shift
        case "${1:-}" in
            stop)
                cmd_app_stop
                ;;
            restart)
                cmd_app_restart
                ;;
            status)
                cmd_app_status
                ;;
            logs)
                cmd_app_logs
                ;;
            *)
                die "Usage: ai app {stop|restart|status|logs}"
                ;;
        esac
        ;;
    preview) cmd_preview ;;
    dsh)
        shift
        case "${1:-}" in
            update)
                shift
                cmd_dsh_update "$@"
                ;;
            version)
                cmd_dsh_version
                ;;
            *)
                die "Usage: ai dsh {update|version}"
                ;;
        esac
        ;;
    cache)
        if [[ "${2:-}" == "clear" ]]; then
            cmd_cache_clear
        else
            cmd_cache
        fi
        ;;
    update) cmd_update ;;
    upgrade) cmd_upgrade ;;
    doctor) cmd_doctor ;;
    github)
        shift
        cmd_github "$@"
        ;;
    state)
        shift
        case "${1:-}" in
            export) cmd_state_export ;;
            import)
                shift
                cmd_state_import "$@"
                ;;
            *)
                die "Usage: ai state {export|import}"
                ;;
        esac
        ;;
    help|--help|-h|"") usage ;;
    *) die "Unknown command: $1" ;;
esac
